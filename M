<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - متجر ميكسيكي</title>
    <style>
        body { font-family: Tahoma, sans-serif; background: #f4f7f6; margin: 0; padding: 20px; }
        .container { max-width: 600px; margin: auto; background: #fff; padding: 20px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        h2 { text-align: center; color: #333; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input[type="text"], input[type="password"] { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; box-sizing: border-box; }
        button { background: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; width: 100%; font-size: 16px; }
        button:hover { background: #218838; }
        .btn-danger { background: #dc3545; margin-top: 5px; }
        .btn-danger:hover { background: #c82333; }
        .product-item { background: #f9f9f9; padding: 10px; border: 1px solid #ddd; border-radius: 5px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        #adminPanel { display: none; }
        .back-link { display: block; text-align: center; margin-top: 15px; color: #007bff; text-decoration: none; }
    </style>
</head>
<body>

<div class="container">
    <!-- نافذة إدخال الرمز السري -->
    <div id="loginBox">
        <h2>🔒 تسجيل دخول المالك</h2>
        <div class="form-group">
            <label>أدخل رمز الحماية (PIN):</label>
            <input type="password" id="pinInput" placeholder="الرمز الافتراضي: 1234">
        </div>
        <button onclick="checkPin()">دخول لوحة التحكم</button>
        <a href="index.html" class="back-link">العودة للمتجر الرئيسي</a>
    </div>

    <!-- لوحة التحكم الفعلية -->
    <div id="adminPanel">
        <h2>🛠️ لوحة التحكم والإدارة</h2>
        
        <div class="form-group">
            <label>اسم المنتج الجديد:</label>
            <input type="text" id="newTitle" placeholder="مثال: سماعة بلوتوث">
        </div>
        <div class="form-group">
            <label>سعر المنتج:</label>
            <input type="text" id="newPrice" placeholder="مثال: 25,000 ر.س">
        </div>
        <button onclick="addProduct()">➕ إضافة المنتج للمتجر</button>

        <hr style="margin: 20px 0;">

        <h3>📦 المنتجات الحالية في المتجر</h3>
        <div id="productsList"></div>

        <a href="index.html" class="back-link">عرض المتجر الرئيسي</a>
    </div>
</div>

<script>
    const SECRET_PIN = "1234"; // يمكنك تغيير الرمز السري هنا إلى أي رقم تريده

    function checkPin() {
        let pin = document.getElementById('pinInput').value;
        if (pin === SECRET_PIN) {
            document.getElementById('loginBox').style.display = 'none';
            document.getElementById('adminPanel').style.display = 'block';
            loadProductsAdmin();
        } else {
            alert("❌ الرمز السري غير صحيح!");
        }
    }

    function getProducts() {
        let products = localStorage.getItem('storeProducts');
        if (products) {
            return JSON.parse(products);
        } else {
            // منتج افتراضي ابتدائي إذا لم تقم بإضافة شيء
            return [{ title: "اسم المنتج الأول", price: "15,000 ر.س" }];
        }
    }

    function saveProducts(products) {
        localStorage.setItem('storeProducts', JSON.stringify(products));
    }

    function loadProductsAdmin() {
        let products = getProducts();
        let listDiv = document.getElementById('productsList');
        listDiv.innerHTML = "";

        products.forEach((prod, index) => {
            listDiv.innerHTML += `
                <div class="product-item">
                    <div>
                        <strong>${prod.title}</strong><br>
                        <small>${prod.price}</small>
                    </div>
                    <button class="btn-danger" style="width: auto; padding: 5px 10px;" onclick="deleteProduct(${index})">حذف</button>
                </div>
            `;
        });
    }

    function addProduct() {
        let title = document.getElementById('newTitle').value;
        let price = document.getElementById('newPrice').value;

        if (!title || !price) {
            alert("الرجاء إدخال اسم المنتج والسعر!");
            return;
        }

        let products = getProducts();
        products.push({ title: title, price: price });
        saveProducts(products);

        document.getElementById('newTitle').value = "";
        document.getElementById('newPrice').value = "";
        
        loadProductsAdmin();
        alert("✅ تم إضافة المنتج بنجاح وتحديث المتجر!");
    }

    function deleteProduct(index) {
        let products = getProducts();
        products.splice(index, 1);
        saveProducts(products);
        loadProductsAdmin();
        alert("🗑️ تم حذف المنتج!");
    }
</script>

</body>
</html>
